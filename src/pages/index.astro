---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import activities from '../data/activities.json';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes', ({ data }) => !data.draft);
const posts = await getCollection('writing', ({ data }) => !data.draft);

// Dates may be a year, month or full day; keep the recorded precision.
const recentActivities = [...activities].sort((a, b) => b.date.localeCompare(a.date));

const recent = [
  ...notes.map((n) => ({ ...n.data, href: `/notes/${n.id}`, kind: 'note' })),
  ...posts.map((p) => ({ ...p.data, href: `/writing/${p.id}`, kind: 'post' })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toISOString().slice(0, 10).replace(/-/g, '‑');
---
<Base>
  <p class="positioning">{site.positioning}</p>

  <div class="intro">
    <img class="intro__photo" src={site.photo} alt={site.name} width="120" height="120" />
    <div class="intro__copy">
      <p class="intro__role">
        {site.role}
      </p>
      {site.bio.map((line) => (
        <p class="bio">{line.map((part) => typeof part === 'string' ? part : <a href={part.url}>{part.label}</a>)}</p>
      ))}
    </div>
  </div>

  <ul class="linkrow" aria-label="Profile links">
    <li class="linkrow__primary"><a href={site.cvPdf} download>Download CV</a></li>
    <li class="linkrow__primary"><a href={`mailto:${site.email}`}>Email</a></li>
    {site.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
  </ul>

  <h2>Recent activities</h2>
  {recentActivities.map((activity) => (
    <article class="entry">
      <div class="entry__stamp entry__stamp--typed">
        {activity.date.length === 4
          ? <span>{activity.date}</span>
          : <time datetime={activity.date}>{activity.date.replace(/-/g, '‑')}</time>}
        <span class="entry__stamp-sep" aria-hidden="true">·</span><span>{activity.kind}</span>
      </div>
      <div class="entry__body">
        <h3 class="entry__title">{activity.url ? <a href={activity.url}>{activity.title}</a> : activity.title}</h3>
        <p class="entry__why">{typeof activity.summary === 'string'
          ? activity.summary
          : activity.summary.map((part) => typeof part === 'string' ? part : <a href={part.url}>{part.label}</a>)}</p>
        {'links' in activity && activity.links && (
          <p class="entry__meta">{activity.links.map((link) => <a href={link.url}>{link.label}</a>)}</p>
        )}
      </div>
    </article>
  ))}

  {recent.length > 0 && (
    <>
      <h2>Highlights</h2>
      {recent.map((r) => (
      <article class="entry">
        <div class="entry__stamp entry__stamp--typed">
          <time datetime={r.date.toISOString().slice(0, 10)}>{fmt(r.date)}</time>
          <span class="entry__stamp-sep" aria-hidden="true">·</span><span>{r.kind}</span>
        </div>
        <div class="entry__body">
          <h3 class="entry__title"><a href={r.href}>{r.title}</a></h3>
          <p class="entry__meta">{r.summary}</p>
        </div>
      </article>
      ))}
    </>
  )}
</Base>
